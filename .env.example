# Database Configuration
DATABASE_URL=sqlite:///./agtech.db
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/agtech

# Security
# MUST change in production! Run `openssl rand -hex 32` to generate a new key
SECRET_KEY=super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Smart AgriTech API"
ENVIRONMENT=development

# Admin defaults (used only during initial seed)
ADMIN_EMAIL=admin@agtech.com
ADMIN_PASSWORD=admin123
ADMIN_NAME="System Administrator"

# External Integrations (Optional for local dev)
# SMTP settings for email notifications
# SMTP_TLS=True
# SMTP_PORT=587
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAILS_FROM_EMAIL=info@agtech.com
