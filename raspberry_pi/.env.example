# Environment variables for the Pi Rover Client
# Copy this to /home/pi/agtech_rover/.env on the Raspberry Pi

ROVER_ID=ROVER-4WD-01
ROVER_MQTT_BROKER=192.168.0.109
ROVER_MQTT_PORT=1883
MQTT_TOPIC_PREFIX=agritech/rover
TELEMETRY_HZ=2
CAMERA_ENABLED=true
GPS_ENABLED=false
INA219_ENABLED=false
SIMULATE_HARDWARE=false
